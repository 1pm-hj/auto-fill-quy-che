{
  "manifest_version": 3,
  "name": "Auto Fill Quy chế",
  "version": "1.0",
  "description": "Tự động điền đáp án bài kiểm tra Quy chế trên Microsoft Forms.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": { "128": "icon.png" },
  "content_scripts": [
    {
      "matches": [
        "https://forms.cloud.microsoft/*",
        "https://forms.office.com/*",
        "https://forms.microsoft.com/*"
      ],
      "js": ["scripts/answers.js", "scripts/content.js"],
      "run_at": "document_idle"
    }
  ]
}
